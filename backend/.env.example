# Copier en .env (jamais commité). Sous Colab, ces valeurs viennent des "Secrets" (icône clé).

# Spotify Developer Dashboard -> ton app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Doit être déclarée À L'IDENTIQUE dans le dashboard Spotify (Redirect URIs).
# Spotify exige HTTPS (ou une IP loopback 127.0.0.1) -> sous Colab : URL du tunnel ngrok.
SPOTIFY_REDIRECT_URI=https://ton-domaine.ngrok-free.app/auth/callback

# Où renvoyer l'utilisateur après connexion (front Next.js ; sous Colab : l'API elle-même)
FRONTEND_URL=https://ton-domaine.ngrok-free.app/docs

# Clé de signature des cookies de session : python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# "lax" quand front et API sont sur le même domaine ; "none" quand le front Vercel appelle l'API Railway.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# Discogs : discogs.com -> Settings -> Developers -> "Generate new token"
DISCOGS_TOKEN=
# Optionnel : fichier où garder les correspondances Discogs entre deux redémarrages
DISCOGS_CACHE_PATH=

# Supabase : bouton "Connect" -> "Session pooler" -> URI (remplacer [YOUR-PASSWORD]).
# Sans cette variable, tout reste en mémoire.
DATABASE_URL=

# Apify (Vinted, Leboncoin) : console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=
